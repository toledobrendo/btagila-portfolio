# Public site (Astro) — build-time configuration.
#
# Copy to `.env` for local development. Values are read at BUILD time: the gallery
# data is fetched from the backend while the site is being built (see
# ../ARCHITECTURE.md §1 and §7).
#
# The PUBLIC_ prefix means the value is also available in the browser bundle — the
# contact form posts to the API from the visitor's browser (Phase 6), so the API base
# URL must be client-visible. Never put secrets in a PUBLIC_ variable.

# Base URL of the backend API (public, read-only endpoints under /api/**).
PUBLIC_API_BASE_URL=http://localhost:8080
