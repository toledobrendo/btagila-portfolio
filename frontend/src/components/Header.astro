---
const navItems = [
	{ href: '/gallery', label: 'Gallery' },
	{ href: '/about', label: 'About' },
];
---

<header class="mt-6 bg-surface">
	<div
		class="mx-auto flex h-[41px] w-full max-w-[1280px] items-center justify-between px-4 sm:px-6 lg:h-[59px]"
	>
		<a href="/" class="flex min-w-0 items-center gap-2 lg:gap-3">
			<img
				src="/images/logo.webp"
				alt=""
				width="1200"
				height="1213"
				class="h-8 w-8 shrink-0 object-contain lg:h-10 lg:w-10"
			/>
			<span class="truncate font-roboto text-[16px] leading-none text-ink lg:text-[24px]"
				>BTAgila Digitalworks</span
			>
		</a>

		<nav class="hidden items-center gap-7 sm:flex" aria-label="Main">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="flex h-10 items-center font-roboto text-[16px] leading-none text-ink transition-colors hover:text-white lg:h-11 lg:text-[24px] lg:leading-[28px]"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<details class="relative sm:hidden">
			<summary
				class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-sm text-ink [&::-webkit-details-marker]:hidden"
				aria-label="Open menu"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					class="h-6 w-6"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</summary>
			<nav
				class="absolute right-0 top-full z-50 mt-2 w-44 rounded-sm border border-line/60 bg-surface p-2 shadow-xl"
				aria-label="Mobile"
			>
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class="block rounded-sm px-3 py-3 font-roboto text-[16px] leading-none text-ink transition-colors hover:bg-black/20"
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</details>
	</div>
</header>
