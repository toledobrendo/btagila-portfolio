---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { albums } from '../../data/albums';
---

<BaseLayout
	title="Gallery — BTagila Digitalworks"
	description="Browse cosplay photography albums by BTagila Digitalworks."
>
	<div
		class="mx-auto w-[calc(100%_-_24px)] max-w-[366px] pt-6 sm:w-full sm:max-w-[560px] sm:pt-12 md:w-[calc(100%_-_512px)] md:max-w-none"
	>
		<h1 class="sr-only">Gallery</h1>

		<div class="relative">
			<label for="gallery-search" class="sr-only">Search albums</label>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.75"
				stroke-linecap="round"
				class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-chip"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m16 16 4 4"></path>
			</svg>
			<input
				id="gallery-search"
				type="search"
				placeholder="Search"
				autocomplete="off"
				class="h-14 w-full rounded-[4px] border border-line bg-surface pl-12 pr-4 text-[14px] text-ink placeholder:text-chip/60 focus-visible:border-chip focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-chip/40"
			/>
		</div>

		<p id="gallery-status" class="sr-only" aria-live="polite"></p>

		<ul class="mt-8 grid grid-cols-2 gap-[10px] sm:grid-cols-3 lg:grid-cols-4">
			{
				albums.map((album) => (
					<li
						data-album-card
						data-search={`${album.title} ${album.tags.join(' ')}`.toLowerCase()}
					>
						<AlbumCard album={album} />
					</li>
				))
			}
		</ul>

		<p id="gallery-empty" hidden class="mt-10 text-center text-[14px] text-chip">
			No albums match your search.
		</p>

		<nav aria-label="Pagination" class="mt-14 flex items-center justify-center gap-2 text-[14px]">
			<span
				aria-current="page"
				class="flex h-10 min-w-10 items-center justify-center rounded-sm border border-chip/40 bg-accent px-3 text-chip"
			>
				1
			</span>
			<span aria-disabled="true" class="flex h-10 items-center gap-1 px-3 text-chip/40">
				Next <span aria-hidden="true">→</span>
			</span>
		</nav>
	</div>

	<script>
		const input = document.getElementById('gallery-search') as HTMLInputElement | null;
		const cards = Array.from(
			document.querySelectorAll<HTMLElement>('[data-album-card]')
		);
		const empty = document.getElementById('gallery-empty') as HTMLElement | null;
		const status = document.getElementById('gallery-status') as HTMLElement | null;

		if (input && cards.length > 0) {
			const update = () => {
				const query = input.value.trim().toLowerCase();
				let visible = 0;

				for (const card of cards) {
					const match = query.length === 0 || (card.dataset.search ?? '').includes(query);
					card.hidden = !match;
					if (match) visible += 1;
				}

				if (empty) empty.hidden = visible !== 0;
				if (status) status.textContent = `${visible} album${visible === 1 ? '' : 's'} found`;
			};

			input.addEventListener('input', update);
			update();
		}
	</script>
</BaseLayout>
