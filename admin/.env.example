# Admin app — local development configuration.
#
# Copy to `.env.local` (gitignored) or `.env`. Vite exposes only VITE_-prefixed
# variables to the app, and those values end up in the client bundle — never put
# secrets here.
#
# The admin runs on the photographer's local machine and calls the backend over a
# private tunnel (see ../ARCHITECTURE.md §6). Admin endpoints live under /admin/**.

# Base URL of the backend API.
VITE_API_BASE_URL=http://localhost:8080
